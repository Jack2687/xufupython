{
  "openapi": "3.1.0",
  "info": {
    "title": "序付 API",
    "version": "1.1.0",
    "description": "查询账户、套餐、报价与订单，检查账号 Session，以及兑换余额。"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前站点"
    }
  ],
  "paths": {
    "/api/v1/wallet": {
      "get": {
        "operationId": "get_wallet",
        "summary": "查询余额",
        "description": "可用余额 = balance − frozen。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Wallet"
                },
                "example": {
                  "balance": 10000,
                  "frozen": 2000,
                  "fee_override": null,
                  "unit": "cent_R",
                  "membership": {
                    "current": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "automatic": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "next": null,
                    "spent": 0,
                    "remaining": 0,
                    "progress": 100,
                    "source": "automatic",
                    "until": null,
                    "fee_override": null,
                    "tiers": [
                      {
                        "code": "L1",
                        "name": "会员",
                        "threshold": 0,
                        "discount": 100,
                        "description": ""
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API 密钥无效或账户不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "记录不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/catalog": {
      "get": {
        "operationId": "get_catalog",
        "summary": "查询套餐",
        "description": "返回在售套餐、当前账户服务费和支持的订阅地区。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Product"
                      }
                    },
                    "membership": {
                      "$ref": "#/components/schemas/Membership"
                    },
                    "unit": {
                      "type": "string",
                      "description": "服务费单位：cent_R。"
                    },
                    "countries": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "description": "地区代码。"
                          },
                          "name": {
                            "type": "string",
                            "description": "地区名称。"
                          },
                          "currency": {
                            "type": "string",
                            "description": "币种。"
                          }
                        }
                      }
                    },
                    "payment_connected": {
                      "type": "boolean",
                      "description": "网页订阅办理是否可用。"
                    }
                  }
                },
                "example": {
                  "items": [
                    {
                      "id": "pro5x",
                      "name": "Pro 5x",
                      "description": "",
                      "fee": 10000,
                      "member_fee": 10000,
                      "tag": "",
                      "features": []
                    }
                  ],
                  "membership": {
                    "current": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "automatic": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "next": null,
                    "spent": 0,
                    "remaining": 0,
                    "progress": 100,
                    "source": "automatic",
                    "until": null,
                    "fee_override": null,
                    "tiers": [
                      {
                        "code": "L1",
                        "name": "会员",
                        "threshold": 0,
                        "discount": 100,
                        "description": ""
                      }
                    ]
                  },
                  "unit": "cent_R",
                  "countries": [
                    {
                      "code": "US",
                      "name": "美国",
                      "currency": "USD"
                    }
                  ],
                  "payment_connected": true
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API 密钥无效或账户不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "记录不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/quote": {
      "get": {
        "operationId": "get_quote",
        "summary": "查询服务费报价",
        "description": "按套餐与当前账户会员等级计算平台服务费；不创建订单。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fee": {
                      "type": "integer",
                      "description": "当前账户服务费，单位：分 R（100 分 R = 1 R）。",
                      "minimum": 0
                    },
                    "standard": {
                      "type": "integer",
                      "description": "标准服务费，单位：分 R（100 分 R = 1 R）。",
                      "minimum": 0
                    },
                    "membership": {
                      "$ref": "#/components/schemas/Membership"
                    }
                  }
                },
                "example": {
                  "fee": 10000,
                  "standard": 10000,
                  "membership": {
                    "current": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "automatic": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "next": null,
                    "spent": 0,
                    "remaining": 0,
                    "progress": 100,
                    "source": "automatic",
                    "until": null,
                    "fee_override": null,
                    "tiers": [
                      {
                        "code": "L1",
                        "name": "会员",
                        "threshold": 0,
                        "discount": 100,
                        "description": ""
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API 密钥无效或账户不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "记录不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "required": true,
            "description": "从套餐列表取得的编号。",
            "schema": {
              "type": "string"
            },
            "example": "pro5x"
          }
        ]
      }
    },
    "/api/v1/membership": {
      "get": {
        "operationId": "get_membership",
        "summary": "查询会员权益",
        "description": "查询会员等级、套餐优惠及最近 100 条已结算订单的成长记录。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "membership": {
                      "$ref": "#/components/schemas/Membership"
                    },
                    "products": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "套餐编号。"
                          },
                          "name": {
                            "type": "string",
                            "description": "套餐名称。"
                          },
                          "description": {
                            "type": "string",
                            "description": "套餐说明。"
                          },
                          "fee": {
                            "type": "integer",
                            "description": "标准服务费，单位：分 R（100 分 R = 1 R）。",
                            "minimum": 0
                          },
                          "member_fee": {
                            "type": "integer",
                            "description": "当前账户服务费，单位：分 R（100 分 R = 1 R）。",
                            "minimum": 0
                          },
                          "enabled": {
                            "type": "boolean",
                            "description": "是否在售。"
                          },
                          "saved": {
                            "type": "integer",
                            "description": "相对标准价节省金额，单位：分 R（100 分 R = 1 R）。",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "growth": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "订单编号。"
                          },
                          "product_name": {
                            "type": "string",
                            "description": "套餐名称。"
                          },
                          "updated_at": {
                            "type": "string",
                            "description": "更新时间。",
                            "format": "date-time"
                          },
                          "spent": {
                            "type": "integer",
                            "description": "本单已结算服务费，单位：分 R（100 分 R = 1 R）。",
                            "minimum": 0
                          }
                        }
                      }
                    },
                    "unit": {
                      "type": "string",
                      "description": "服务费单位：cent_R。"
                    },
                    "basis": {
                      "type": "string",
                      "description": "成长依据。",
                      "enum": [
                        "settled_service_spend"
                      ]
                    }
                  }
                },
                "example": {
                  "membership": {
                    "current": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "automatic": {
                      "code": "L1",
                      "name": "会员",
                      "threshold": 0,
                      "discount": 100,
                      "description": ""
                    },
                    "next": null,
                    "spent": 0,
                    "remaining": 0,
                    "progress": 100,
                    "source": "automatic",
                    "until": null,
                    "fee_override": null,
                    "tiers": [
                      {
                        "code": "L1",
                        "name": "会员",
                        "threshold": 0,
                        "discount": 100,
                        "description": ""
                      }
                    ]
                  },
                  "products": [],
                  "growth": [],
                  "unit": "cent_R",
                  "basis": "settled_service_spend"
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API 密钥无效或账户不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "记录不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/inspect": {
      "post": {
        "operationId": "inspect_session",
        "summary": "检查账号 Session",
        "description": "只检查格式、账号信息和有效期，不代表订阅已生效。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                },
                "example": {
                  "email": "account@example.com",
                  "account_id": "ACCOUNT_ID",
                  "plan": "free",
                  "expires_at": "2030-01-01T00:00:00Z",
                  "status": "format_valid",
                  "online_verified": false
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API 密钥无效或账户不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "记录不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "session": {
                    "anyOf": [
                      {
                        "$ref": "#/components/schemas/Session"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "description": "完整 Session 对象，或包含该对象的 JSON 字符串。"
                  }
                },
                "required": [
                  "session"
                ]
              },
              "example": {
                "session": {
                  "accessToken": "YOUR_ACCOUNT_ACCESS_TOKEN",
                  "user": {
                    "email": "account@example.com"
                  },
                  "account": {
                    "id": "ACCOUNT_ID",
                    "planType": "free"
                  },
                  "expires": "2030-01-01T00:00:00Z"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/wallet/redeem": {
      "post": {
        "operationId": "redeem_code",
        "summary": "兑换余额",
        "description": "每张兑换码只能使用一次。请求超时后先查询余额，不要自动反复兑换。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "description": "兑换是否成功。"
                    },
                    "amount": {
                      "type": "integer",
                      "description": "本次入账金额，单位：分 R（100 分 R = 1 R）。",
                      "minimum": 0
                    }
                  }
                },
                "example": {
                  "ok": true,
                  "amount": 10000
                }
              }
            }
          },
          "400": {
            "description": "请求参数无效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "API 密钥无效或账户不可用",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "无权访问",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "记录不存在或不属于当前账户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "请求过于频繁",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "服务暂时异常",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "description": "兑换码。"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "example": {
                "code": "YOUR_REDEEM_CODE"
              }
            }
          }
        }
      }
    },
    "/api/v1/orders": {
      "get": {
        "operationId": "list_orders",
        "summary": "查询订单列表",
        "description": "仅返回当前账户最近 200 条订单；支持关键词和状态筛选。",
        "security": [
          {
            "BearerKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Order"
                      }
                    }
                  }
                },
                "example": {
                  "items": [
                    {
                      "id": "ORDER_ID",
                      "product_id": "pro5x",
                      "product_name": "Pro 5x",
                      "email": "account@example.com",
                      "country": "US",
                      "seats": 1,
                      "status": "succeeded",
                      "fee": 10000,
                      "source": "web",
                      "workflow": "subscription",
                      "keep_renewal": false,
                      "activation": "active",
                      "renewal": "disabled",
                      "created_at": "2026-11-03T00:00:00Z",
                      "updated_at": "2026-11-03T00:02:00Z",
                      "price_snapshot": {
                        "standard": 10000,
                        "member_fee": 10000,
                        "membership": "L1"
                      },
                      "payment": {
                        "state": "succeeded",
                        "last4": "4242",
                        "amount": 100,
                        "currency": "USD",
                        "fee_state": "charged",
