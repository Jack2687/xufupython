# Container deployment only. Preserve MASTER_KEY when importing an existing database.
# Use URL-safe random characters for POSTGRES_PASSWORD (no @, /, :, %, # or spaces).
POSTGRES_PASSWORD=replace-with-a-long-random-password
MASTER_KEY=replace-with-base64-of-32-random-bytes
BOOTSTRAP_EMAIL=admin
BOOTSTRAP_PASSWORD=replace-before-first-start
COOKIE_SECURE=false
# HTTPS public origin when a reverse proxy terminates TLS, e.g. https://pay.example.com
PUBLIC_ORIGIN=
APP_VERSION=latest
